@model TechnicalTest.Models.SupplierModel
@{
    ViewBag.Title = "Detail Supplier";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Detail Supplier</h2>

<dl class="dl-horizontal">
    <dt>Kode Supplier</dt>
    <dd>@Model.SupplierCode</dd>

    <dt>Nama Supplier</dt>
    <dd>@Model.SupplierName</dd>

    <dt>Alamat</dt>
    <dd>@Model.Address</dd>

    <dt>Kota</dt>
    <dd>@Model.City</dd>

    <dt>Telepon</dt>
    <dd>@Model.Phone</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Status</dt>
    <dd>@(Model.IsActive ? "Aktif" : "Tidak Aktif")</dd>

    <dt>Dibuat</dt>
    <dd>@Model.CreatedDate.ToString("dd-MM-yyyy HH:mm")</dd>

    @if (Model.ModifiedDate.HasValue)
    {
        <dt>Diubah Terakhir</dt>
        <dd>@Model.ModifiedDate.Value.ToString("dd-MM-yyyy HH:mm")</dd>
    }
</dl>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.SupplierID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Kembali ke List", "Index", null, null, new { @class = "btn btn-default" })
</p>
